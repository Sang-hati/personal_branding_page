
GITHUB_USERNAME= 

# A GitHub personal access token. With a token the dashboard loads your full
# contribution calendar (GraphQL API) and gets 5,000 requests per hour instead of 60.
# A fine-grained token with read-only access to public data is enough.
# The token stays on the server and is never sent to the browser.

GITHUB_TOKEN= 
PORT=3001
HOST=127.0.0.1
